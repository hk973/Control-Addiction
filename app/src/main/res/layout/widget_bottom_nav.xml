<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_bottom_nav"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- Home -->
    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/nav_home_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_home"
            android:contentDescription="Home" />
        <TextView
            android:id="@+id/nav_home_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textSize="10sp"
            android:textColor="@color/nav_selected"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Stats -->
    <LinearLayout
        android:id="@+id/nav_stats"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/nav_stats_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_stats"
            android:contentDescription="Stats"
            android:alpha="0.5" />
        <TextView
            android:id="@+id/nav_stats_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stats"
            android:textSize="10sp"
            android:textColor="@color/nav_unselected"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Settings -->
    <LinearLayout
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/nav_settings_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_settings"
            android:contentDescription="Settings"
            android:alpha="0.5" />
        <TextView
            android:id="@+id/nav_settings_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="10sp"
            android:textColor="@color/nav_unselected"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
