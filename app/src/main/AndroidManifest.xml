<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional Camera Feature -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Required to query all installed packages -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Required for AppUsageTracker — user must grant manually in Settings → Usage Access -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Addiction20"
        tools:targetApi="31">

        <activity
            android:name=".Launcher.Rewards_list"
            android:exported="false" />

        <!-- ── Premium feature screens ──────────────────────────────────── -->
        <activity
            android:name=".Launcher.StatsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowAnimationStyle="@android:style/Animation" />

        <activity
            android:name=".Launcher.StrictLockSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".Launcher.OverlayService"
            android:exported="false"
            android:enabled="true"
            android:permission="android.permission.SYSTEM_ALERT_WINDOW" />

        <activity android:name=".Launcher.BillingActivity" />

        <activity
            android:name=".Launcher.ChallengeReward"
            android:exported="false" />

        <!-- Default Launcher Activity (onboarding wizard) -->
        <activity
            android:name=".Launcher.permission.MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HOME launcher activity -->
        <activity
            android:name=".Launcher.MainContainerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Other App Activities -->
        <activity
            android:name=".Launcher.MainContainerActivity2"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".Launcher.PinInfoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".Launcher.BaseActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".Launcher.SettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowAnimationStyle="@android:style/Animation" />

        <activity
            android:name=".Launcher.PopupActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Dialog" />

        <activity
            android:name=".Launcher.ReviewActivity"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Accessibility Service -->
        <service
            android:name=".Launcher.NotificationBarDetectorService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <!-- Required by Play Store for FOREGROUND_SERVICE_SPECIAL_USE -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="This service runs a persistent timer notification to track and enforce app usage time limits set by the user. It is an accessibility service that monitors which app is in the foreground and blocks restricted apps when the timer expires." />
        </service>

        <!-- Quick Settings Tile -->
        <service
            android:name=".Launcher.MyTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- FCM Service -->
        <service
            android:name=".Launcher.AppFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
